{
  "name": "@ilokesto/utilinent",
  "version": "1.3.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "bench": "node bench/run.mjs",
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:react18": "node scripts/test-react18.mjs",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && pnpm typecheck:react19",
    "test:browser": "tsc --noEmit -p e2e/tsconfig.json && playwright test",
    "typecheck:react19": "pnpm build && tsc --noEmit -p test/react19/tsconfig.json",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "docs:prepare": "pnpm build",
    "docs:dev": "pnpm docs:prepare && pnpm --dir website dev",
    "docs:build": "pnpm docs:prepare && pnpm --dir website build",
    "docs:typecheck": "pnpm docs:prepare && pnpm --dir website typecheck",
    "docs:test": "pnpm --dir website test",
    "docs:start": "pnpm --dir website start",
    "docs:publication:verify": "node scripts/docs-publication.mjs verify && node scripts/docs-runtime.mjs verify",
    "docs:publication:capture": "node scripts/docs-publication.mjs capture",
    "docs:publication:promote": "node scripts/docs-publication.mjs promote",
    "release:verify": "node scripts/release-verify.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/utilinent.git"
  },
  "homepage": "https://ilokesto.ayden94.com/en/utilinent",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "component",
    "util",
    "utility",
    "utilinent"
  ],
  "author": "Jeong Jinho <wpfekdml@me.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react19": "npm:@types/react@19.2.18",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "@changesets/cli": "2.31.1",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@10.17.1"
}
